# Copy to .env (gitignored) and change the values. docker compose reads .env automatically.
# Without a .env, docker-compose.yml falls back to chat/chat/chat, which is fine only for a local demo.
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chat

# true behind HTTPS. Must stay false for plain http://localhost:3000, or browsers drop the cookie.
CHAT_AUTH_COOKIESECURE=false
